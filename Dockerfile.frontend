FROM node:20-slim

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY index.html vite.config.js jsconfig.json ./
COPY public/ public/
COPY src/ src/

EXPOSE 5173

# Serveur de dev Vite (comme en local) — pas un build de prod, cohérent avec l'objectif
# "installation facile" plutôt qu'un déploiement prod optimisé (nginx, build statique, etc.).
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
