# --- Stage 1 : build ---
FROM node:20-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY index.html vite.config.js jsconfig.json ./
COPY public/ public/
COPY src/ src/

# API_HOST/API_PORT/API_HTTPS (voir .env.example) sont lus par src/router/index.js via
# import.meta.env (envPrefix dans vite.config.js) : "vite build" les fige dans les fichiers
# statiques générés. Contrairement au serveur de dev, les changer nécessite donc de reconstruire
# l'image ("docker compose up --build"), pas juste de relancer le conteneur.
ARG API_HOST=localhost
ARG API_PORT=5000
ARG API_HTTPS=false
ENV API_HOST=$API_HOST
ENV API_PORT=$API_PORT
ENV API_HTTPS=$API_HTTPS

RUN npm run build

# --- Stage 2 : service des fichiers statiques ---
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# nginx:1.27-alpine substitue automatiquement, au démarrage du conteneur, les variables d'env
# présentes dans les fichiers /etc/nginx/templates/*.template vers /etc/nginx/conf.d/*.conf (via
# envsubst) — c'est ce qui permet à FRONTEND_PORT (et, si activé, le chemin du certificat TLS) de
# rester configurable à l'exécution malgré un build de fichiers statiques figés. Les deux templates
# possibles (HTTP ou HTTPS, voir API_HTTPS) sont déposés hors du dossier auto-traité :
# /docker-entrypoint.d/19-select-nginx-template.envsh (point d'extension officiel de cette image,
# exécuté avant l'envsubst natif) choisit lequel activer au démarrage du conteneur. Extension
# .envsh (pas .sh) : ce script est alors "sourcé" dans le shell de l'entrypoint plutôt qu'exécuté
# comme sous-processus — indispensable pour que les variables qu'il exporte (chemin du certificat)
# restent visibles de l'étape d'envsubst suivante.
RUN mkdir -p /etc/nginx/templates-available /etc/nginx/templates
COPY nginx.frontend.http.conf.template /etc/nginx/templates-available/http.conf.template
COPY nginx.frontend.https.conf.template /etc/nginx/templates-available/https.conf.template
COPY nginx-select-template.sh /docker-entrypoint.d/19-select-nginx-template.envsh
RUN chmod +x /docker-entrypoint.d/19-select-nginx-template.envsh

ENV FRONTEND_PORT=5173
ENV API_HTTPS=false

EXPOSE 5173
