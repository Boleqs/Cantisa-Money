# Copier en .env à la racine du projet (jamais commité, voir .gitignore).
# Utilisé à la fois par `docker compose` (substitution des ${VAR} dans docker-compose.yml) et par
# le backend lancé sans Docker (python-dotenv remonte les dossiers parents depuis backend/app.py
# et trouve ce fichier tout seul).

# Optionnel — active la catégorisation par IA (routes /api/ai/*). Sans cette clé, l'app
# fonctionne normalement, ces routes renvoient juste une erreur si utilisées.
ANTHROPIC_API_KEY=

# Mot de passe du conteneur Postgres (Docker uniquement).
POSTGRES_PASSWORD=postgres

# Connexion PostgreSQL pour un lancement SANS Docker — laisser vide pour garder les valeurs par
# défaut de backend/database/config.py. Sans objet avec docker-compose (qui définit ces variables
# directement sur le conteneur backend).
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Sécurité — laisser vide en dev (valeurs par défaut stables dans config.py), mais à définir
# obligatoirement avec des valeurs uniques et secrètes pour un vrai déploiement.
FLASK_SECRET_KEY=
PWD_PEPPER=

# true : repart d'une base vide + jeu de données de démo à chaque démarrage du backend
# (comportement historique de ce projet). false (ou vide, défaut) : conserve les données entre
# deux redémarrages.
RESET_DB_ON_START=false

# true (défaut) : peuple une base vide avec le jeu de données de test (comptes Loris/Alice,
# transactions, budgets...). false : base vide, voir ADMIN_* ci-dessous pour se connecter (sinon
# aucun moyen de se connecter, il n'y a pas d'inscription publique dans l'app).
DEMO_DATA=true
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Une ou plusieurs origines séparées par des virgules autorisées à appeler l'API (CORS) — à
# adapter si le frontend n'est pas servi sur localhost:5173 (ex: un vrai nom de domaine en prod).
CORS_ORIGINS=http://localhost:5173

# Cookies JWT : Secure exige HTTPS, à activer derrière un reverse proxy HTTPS en vrai déploiement
# (pas avec ce docker-compose qui tourne en HTTP simple). CSRF activé par défaut, géré côté
# frontend via axios.defaults.xsrf* (voir src/router/index.js) — ne pas désactiver sans savoir
# pourquoi.
JWT_COOKIE_SECURE=false
JWT_COOKIE_CSRF_PROTECT=true
