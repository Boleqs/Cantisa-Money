# Copier en .env à la racine (jamais commité). Tout est optionnel, les valeurs par défaut
# conviennent pour un usage local ou LAN. Lu par docker-compose et par le backend (python-dotenv).

# Mot de passe Postgres (Docker) — laisser vide : un mot de passe aléatoire est généré au premier
# démarrage et persisté (backend/instance/db_password.txt), comme FLASK_SECRET_KEY/PWD_PEPPER plus
# bas. Ne définir explicitement que pour imposer une valeur précise.
POSTGRES_PASSWORD=

# Port Postgres exposé sur la machine hôte (accès direct via un client externe type pgAdmin) — à
# changer seulement en cas de conflit avec un autre Postgres local.
POSTGRES_PORT=5432

# false (défaut) : jeu de données de démo (comptes John/Alice, mot de passe CantisaDemo2026!).
# true : base vide — se connecter via ADMIN_USERNAME/ADMIN_EMAIL/ADMIN_PASSWORD ci-dessous (pas
# d'inscription publique sinon).
DEMO_DATA=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================================================
#  Reverse proxy & accès réseau (Docker)
# ============================================================================
# Architecture : un seul conteneur exposé, "caddy" (reverse proxy). Il sert le frontend et route
# /api/* vers le backend. backend et frontend ne sont PLUS joignables directement depuis l'hôte.
# Le frontend appelle l'API en relatif (/api) : changer l'adresse publique ne nécessite plus de
# rebuild, un simple "docker compose up" suffit.

# Ports publics de caddy. Défauts 80/443. À changer en cas de conflit sur l'hôte (attention :
# EDGE_ACME_DOMAIN exige alors un accès direct au 443 depuis Internet).
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS client -> caddy ("edge") ---
# true (défaut) : caddy termine le TLS côté client. Priorité du certificat utilisé :
#   1. EDGE_ACME_DOMAIN renseigné  -> certificat public automatique (Let's Encrypt / ZeroSSL)
#   2. TLS_CERT_PATH/KEY renseignés -> certificat fourni par l'utilisateur
#   3. sinon                        -> certificat auto-signé du backend, réutilisé (le même que le
#                                      saut interne ; avertissement navigateur à accepter une fois)
# false : caddy sert en HTTP clair — à utiliser UNIQUEMENT si tu mets ton propre reverse proxy
# devant (il termine alors le TLS et forwarde vers caddy). Pense à JWT_COOKIE_SECURE ci-dessous.
EDGE_HTTPS=true

# Certificat public automatique. Laisser VIDE par défaut : l'app n'est pas forcément exposée sur
# Internet, et ACME échouerait. Ne renseigner que si le domaine pointe vers ce serveur et que les
# ports 80 + 443 sont joignables publiquement.
EDGE_ACME_DOMAIN=
EDGE_ACME_EMAIL=

# Certificat "edge" fourni par l'utilisateur (chemins DANS le conteneur caddy). Monter le dossier
# le contenant via le volume commenté du service caddy dans docker-compose.yml.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Le saut interne caddy -> backend/frontend est toujours chiffré (certificat auto-signé généré au
# démarrage du backend, non vérifié par caddy — réseau Docker isolé). Rien à configurer.

# Cookie de session en Secure (HTTPS obligatoire). true par défaut (le TLS edge de caddy).
# Mettre false uniquement si EDGE_HTTPS=false ET que le proxy amont ne fait pas de HTTPS.
JWT_COOKIE_SECURE=true

# Origine(s) autorisées à appeler l'API en cross-origin (séparées par des virgules). Inutile dans
# le déploiement nominal (same-origin via le reverse proxy) — ne renseigner que pour un accès
# direct au backend depuis une autre origine.
CORS_ORIGINS=

# Taille maximale d'un upload, en Mo (import de sauvegarde, coffre-fort de documents, OCR de
# factures). Appliquée à caddy ET au backend.
MAX_UPLOAD_MB=500

# Ports internes (rarement à changer — ils ne sont plus exposés sur l'hôte, seulement utilisés
# sur le réseau Docker et par le proxy Vite en dev).
API_PORT=5000
FRONTEND_PORT=5173

# --- Synchro bancaire (Enable Banking) ---
# Se configure normalement depuis l'app (Administration > Intégrations, réservé aux comptes avec la
# permission "Administration") plutôt qu'ici : app_id, clé privée .pem (upload) et redirect_url s'y
# enregistrent dans backend/instance/ (persisté par le volume Docker instance_data, voir
# docker-compose.yml) — voir backend/utils/enable_banking.py. Les variables ci-dessous restent
# prioritaires si définies, pour les déploiements scriptés/CI.
ENABLE_BANKING_APP_ID=
# URL de callback après autorisation bancaire, doit être whitelistée au Control Panel Enable
# Banking (enablebanking.com) pour cette application. Laisser vide pour
# http://localhost:5173/bank-sync/callback. Derrière le reverse proxy : https://<domaine>/bank-sync/callback.
ENABLE_BANKING_REDIRECT_URL=

# --- Avancé, rarement nécessaire ---
# Écrasent la génération auto de secrets (persistés dans backend/instance/) — utile seulement pour
# imposer une valeur précise.
FLASK_SECRET_KEY=
PWD_PEPPER=
# Accès direct au backend SANS reverse proxy (dev sans le proxy Vite, LAN). Renseigné, le frontend
# construit une URL absolue http(s)://API_HOST:API_PORT au lieu d'appels relatifs. En dev
# (npm run dev) le proxy Vite gère /api tout seul : laisser vide.
API_HOST=
API_HTTPS=
# Connexion Postgres pour un lancement SANS Docker (sinon défauts de backend/database/config.py).
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# true : repart d'une base vide + démo à chaque démarrage, au lieu de conserver les données.
RESET_DB_ON_START=false
