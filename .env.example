# Copier en .env à la racine (jamais commité). Tout est optionnel, les valeurs par défaut
# conviennent pour un usage local ou LAN. Lu par docker-compose et par le backend (python-dotenv).

# Mot de passe Postgres (Docker) — laisser vide : un mot de passe aléatoire est généré au premier
# démarrage et persisté (backend/instance/db_password.txt), comme FLASK_SECRET_KEY/PWD_PEPPER plus
# bas. Ne définir explicitement que pour imposer une valeur précise.
POSTGRES_PASSWORD=

# Port Postgres exposé sur la machine hôte (accès direct via un client externe type pgAdmin) — à
# changer seulement en cas de conflit avec un autre Postgres local.
POSTGRES_PORT=5432

# false (défaut) : jeu de données de démo (comptes John/Alice, mot de passe CantisaDemo2026!).
# true : base vide — se connecter via ADMIN_USERNAME/ADMIN_EMAIL/ADMIN_PASSWORD ci-dessous (pas
# d'inscription publique sinon).
DEMO_DATA=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Accès depuis un autre appareil (LAN, hébergement externe) ---
# Par défaut l'app n'est joignable que depuis cette machine. Pour un accès distant, renseigner
# API_HOST (IP/domaine du serveur) ; changer les ports seulement en cas de conflit. Un changement
# d'API_HOST/API_PORT/API_HTTPS nécessite "docker compose up --build" (figés au build du frontend).
API_HOST=localhost
API_PORT=5000
FRONTEND_PORT=5173
# Doit rester cohérent avec API_HTTPS ci-dessous (http:// ou https://) : c'est l'origine que le
# navigateur envoie réellement, le backend refuse toute autre origine.
CORS_ORIGINS=http://localhost:5173

# true : sert l'API ET le frontend en HTTPS (même certificat auto-signé généré automatiquement, ou
# fourni via TLS_CERT_PATH/TLS_KEY_PATH plus bas) et sécurise les cookies de session — nécessaire
# pour tout accès hors LAN de confiance. Pas de reverse proxy dans ce projet : chaque service
# termine TLS lui-même (gunicorn côté API, nginx ou le serveur de dev Vite côté frontend).
API_HTTPS=false

# --- Synchro bancaire (Enable Banking) ---
# Se configure normalement depuis l'app (Administration > Intégrations, réservé aux comptes avec la
# permission "Administration") plutôt qu'ici : app_id, clé privée .pem (upload) et redirect_url s'y
# enregistrent dans backend/instance/ (persisté par le volume Docker instance_data, voir
# docker-compose.yml) — voir backend/utils/enable_banking.py. Les variables ci-dessous restent
# prioritaires si définies, pour les déploiements scriptés/CI.
ENABLE_BANKING_APP_ID=
# URL de callback après autorisation bancaire, doit être whitelistée au Control Panel Enable
# Banking (enablebanking.com) pour cette application. Laisser vide pour
# http://localhost:5173/bank-sync/callback.
ENABLE_BANKING_REDIRECT_URL=

# --- Avancé, rarement nécessaire ---
# Écrasent la génération auto de secrets (persistés dans backend/instance/) — utile seulement pour
# imposer une valeur précise.
FLASK_SECRET_KEY=
PWD_PEPPER=
# Certificat TLS existant, à la place de celui auto-signé généré par défaut (voir API_HTTPS) —
# partagé entre le backend et le frontend (un certificat est lié à un nom d'hôte, pas à un port).
TLS_CERT_PATH=
TLS_KEY_PATH=
# Connexion Postgres pour un lancement SANS Docker (sinon défauts de backend/database/config.py).
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# true : repart d'une base vide + démo à chaque démarrage, au lieu de conserver les données.
RESET_DB_ON_START=false
